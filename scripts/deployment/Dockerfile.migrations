ARG NODE_MIGRATION_IMAGE=node:22.23.1-alpine3.23@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
FROM ${NODE_MIGRATION_IMAGE}

ARG RELEASE_SHA
LABEL org.opencontainers.image.title="NextShift OS 3.8 migration runtime" \
      org.opencontainers.image.revision="${RELEASE_SHA}" \
      com.nextshift.migration.node="22.23.1" \
      com.nextshift.migration.pnpm="10.24.0" \
      com.nextshift.migration.prisma="6.19.3" \
      com.nextshift.migration.bash="5.3.3-r1" \
      com.nextshift.migration.psql="17.10-r0"

RUN case "$RELEASE_SHA" in \
      [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; \
      *) printf 'invalid RELEASE_SHA\n' >&2; exit 1 ;; \
    esac

# Network package resolution is allowed only while GitHub builds this immutable
# artifact. The production VPS receives the completed image and performs no apk,
# npm, npx, Corepack, or other network installation.
RUN apk add --no-cache \
      bash=5.3.3-r1 \
      postgresql17-client=17.10-r0 \
    && corepack enable \
    && corepack prepare pnpm@10.24.0 --activate

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --prod \
    && test "$(node --version)" = "v22.23.1" \
    && test "$(pnpm --version)" = "10.24.0" \
    && test "$(./node_modules/.bin/prisma --version | awk '/prisma[[:space:]]*:/ {print $3; exit}')" = "6.19.3" \
    && test "$(apk info -e bash)" = "bash" \
    && test "$(apk info -e postgresql17-client)" = "postgresql17-client"

ENTRYPOINT ["/usr/bin/env", "bash", "/app/scripts/deployment/run-os38-production-migrations.sh"]
