# E1A production env contract v1

# Runtime
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://nextshiftos.com
NEXT_PUBLIC_BASE_DOMAIN=nextshiftos.com

# Database (required)
DATABASE_URL=postgresql://user:password@db.example.com:5432/nextshift?schema=public
DIRECT_URL=postgresql://user:password@db.example.com:5432/nextshift?schema=public

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Providers (at least one required)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
GOOGLE_GENERATIVE_AI_API_KEY=
MINIMAX_API_KEY=
# Deprecated alias. Prefer GOOGLE_GENERATIVE_AI_API_KEY.
GEMINI_API_KEY=

# Auth
NEXTAUTH_SECRET=generate_32_char_random_string
NEXTAUTH_URL=https://nextshiftos.com

# Optional integrations
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
N8N_WEBHOOK_URL=
# VPS Docker Redis: redis://redis:6379
# Upstash Redis: use the REST URL and set REDIS_TOKEN.
REDIS_URL=redis://redis:6379
REDIS_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_COMMIT_SHA=unknown
NEXT_PUBLIC_BUILD_TIME=unknown
NEXT_PUBLIC_ENABLE_EVOLUTION_PROJECTION_V6=false

# Payments
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_SANDBOX=false
BILLPLZ_CALLBACK_URL=https://nextshiftos.com
BILLPLZ_REDIRECT_URL=https://nextshiftos.com/billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
