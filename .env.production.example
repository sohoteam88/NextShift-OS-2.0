# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production

# Database (required)
DATABASE_URL=postgresql://user:password@db.example.com:5432/nextshift?schema=public
DIRECT_URL=postgresql://user:password@db.example.com:5432/nextshift?schema=public

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Providers (at least one required)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
# GOOGLE_GENERATIVE_AI_API_KEY=
# MINIMAX_API_KEY=

# Auth
NEXTAUTH_SECRET=generate_32_char_random_string
NEXTAUTH_URL=https://your-domain.com

# Optional integrations
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# RESEND_API_KEY=
# N8N_WEBHOOK_URL=
# REDIS_URL=
# SENTRY_DSN=
